# Env vars — copy to .env.local and fill in
GOOGLE_CLOUD_PROJECT=demo-eduforge
REGION=us-central1

# Firebase — local dev runs entirely against the Firebase Emulator Suite
# (scripts/dev/start-emulators.sh), so these can stay as-is. No real
# Firebase project, API key, or Google login is required for local dev.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-eduforge
# Only needed if NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false (real Firebase project):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# LLM — free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_GENUI_MODEL=openai/gpt-oss-120b
GROQ_INGESTION_MODEL=openai/gpt-oss-120b

# OpenRouter — optional second provider for GenUI (free key: https://openrouter.ai/keys).
# Free tier: ~50 requests/day, 20/min; free models are slow (~60-80s), so it sits after Groq.
OPENROUTER_API_KEY=

# GenUI model chain as "provider:model", tried in order; unconfigured providers are skipped.
# If every model fails, students get curated content (apps/web/src/lib/genui-fallback.ts), never an error.
# GENUI_MODELS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,openrouter:dots-studio/dots-3-note-preview:free
# "fallback" (default: one model at a time) or "race" (all in parallel, first valid wins — uses more quota)
# GENUI_STRATEGY=fallback

# Service URLs (local dev)
BKT_SERVICE_URL=http://localhost:8001
API_SERVICE_URL=http://localhost:8000
INGESTION_SERVICE_URL=http://localhost:8003

# Document AI (ingestion — optional, only used for scanned/image-heavy slides)
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us
